

{%  style  %} 

.hero-slider__next-btn{
  overflow:hidden;
}

.hero-slider__next-thumb-wrap{
  position:relative;
  overflow:hidden;
}

.thumb-transition-clone{
  position:fixed;
  z-index:99999;
  overflow:hidden;
  pointer-events:none;
}

.thumb-transition-clone img{
  width:100%;
  height:100%;
  object-fit:cover;
}
{% endstyle %} 

{%- if section.blocks.size > 0 -%}
<section
  class="hero-slider"
  id="hero-slider-{{ section.id }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | default: 5000 }}"
  aria-label="Hero slideshow"
>
  {%- comment -%} ── Slides ── {%- endcomment -%}
  <div class="hero-slider__track" aria-live="polite">
    {%- for block in section.blocks -%}
      {%- assign is_first = forloop.first -%}
      {%- assign next_index = forloop.index -%}
      {%- if next_index >= section.blocks.size -%}
        {%- assign next_index = 0 -%}
      {%- endif -%}

      <div
        class="hero-slider__slide{% if is_first %} is-active{% endif %}"
        data-slide-index="{{ forloop.index0 }}"
        data-thumb="{{ block.settings.image | image_url: width: 200 }}"
        {{ block.shopify_attributes }}
        role="group"
        aria-label="Slide {{ forloop.index }} of {{ section.blocks.size }}"
      >
        {%- comment -%} Background image with Ken Burns layer {%- endcomment -%}
        <div class="hero-slider__bg-wrap">
          {%- if block.settings.image != blank -%}

               {%- liquid
                    assign image_loading = 'lazy'
                    assign image_priority = 'auto'

                    if forloop.first
                    assign image_loading = 'eager'
                    assign image_priority = 'high'
                    endif
               -%}

               {{
                    block.settings.image
                    | image_url: width: 1920
                    | image_tag:
                    class: 'hero-slider__bg-img',
                    loading: image_loading,
                    fetchpriority: image_priority,
                    widths: '750, 1100, 1500, 1780, 1920',
                    sizes: '100vw',
                    alt: block.settings.image.alt
               }}
            
               
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-slider__bg-img hero-slider__bg-img--placeholder' }}
          {%- endif -%}
          <div class="hero-slider__overlay"></div>
        </div>

        {%- comment -%} Slide text content {%- endcomment -%}
        <div class="hero-slider__content">
          {%- if block.settings.eyebrow != blank -%}
            <p class="hero-slider__eyebrow text_animation_gsap_container">{{ block.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <div class="hero-slider__heading text_animation_gsap_container">
               {{ block.settings.heading }}
            </div>
          {%- endif -%}
          {%- if block.settings.subheading != blank -%}
            <p class="hero-slider__subheading text_animation_gsap_container">{{ block.settings.subheading | escape }}</p>
          {%- endif -%}
          {%- if block.settings.button_label != blank and block.settings.button_url != blank -%}
            <a
              href="{{ block.settings.button_url }}"
              class="hero-slider__cta"
              {% if block.settings.button_new_tab %}target="_blank" rel="noopener"{% endif %}
            >
              {{- block.settings.button_label | escape -}}
              <span class="hero-slider__cta-arrow" aria-hidden="true">→</span>
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- comment -%} ── Controls Bar (bottom-left) ── {%- endcomment -%}
  <div class="hero-slider__controls" aria-label="Slider controls">

    {%- comment -%} Next-slide thumbnail button {%- endcomment -%}
    <button
      class="hero-slider__next-btn"
      aria-label="Next slide"
      type="button"
    >
      <div class="hero-slider__next-thumb-wrap">
        <img
          class="hero-slider__next-thumb"
          src="{{ section.blocks[1].settings.image | image_url: width: 200 }}"
          alt="Next slide preview"
          width="80"
          height="80"
          loading="lazy"
        />
        <div class="hero-slider__next-thumb-overlay"></div>
      </div>

      {%- comment -%}
        SVG progress ring — traces the perimeter clockwise as the slide timer runs.
        96×96 viewBox, rect inset 1.5px so 3px stroke doesn't clip.
        Perimeter = 2*(93+93) = 372. stroke-dashoffset animated by GSAP 372→0.
        rotate(-90) shifts start point to top-right corner, drawing clockwise.
      {%- endcomment -%}
      <svg class="hero-slider__ring-svg" viewBox="0 0 96 96" aria-hidden="true" focusable="false">
        <rect class="hero-slider__ring-track"
          x="1.5" y="1.5" width="93" height="93"
        />
        <rect class="hero-slider__ring-fill"
          x="1.5" y="1.5" width="93" height="93"
          transform="rotate(-90 48 48)"
        />
      </svg>

      <span class="hero-slider__next-label">Next</span>
    </button>

    {%- comment -%} Counter + progress line {%- endcomment -%}
    <div class="hero-slider__counter-wrap" aria-hidden="true">
      <span class="hero-slider__counter-current">
        {{- 1 | plus: 1 | prepend: '0' | slice: -2, 2 -}}
      </span>
      <div class="hero-slider__progress-track">
        <div class="hero-slider__progress-fill"></div>
      </div>
      <span class="hero-slider__counter-total">
        {{- section.blocks.size | prepend: '0' | slice: -2, 2 -}}
      </span>
    </div>

  </div>

  {%- comment -%} Prev button (optional, accessible) {%- endcomment -%}
  <button
    class="hero-slider__prev-btn"
    aria-label="Previous slide"
    type="button"
  >
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="M12.5 5L7.5 10L12.5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

</section>

{%- endif -%}

{%- comment -%} ── Styles ── {%- endcomment -%}
<style>
/* ─────────────────────────────────────────────
   HERO SLIDER — Base & Layout
───────────────────────────────────────────── */
.hero-slider {
  position: relative;
  width: 100%;
  height: 100svh;
  min-height: 900px;
  overflow: hidden;
  background: #0a0a0a;
  user-select: none;
}

/* ── Track & Slides ── */
.hero-slider__track {
  position: relative;
  width: 100%;
  height: 100%;
}

.hero-slider__slide {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  /* Vertical clip-path wipe — starts fully hidden above */
  clip-path: inset(0 0 100% 0);
  z-index: 1;
  pointer-events: none;
}

/* Active slide is always visible, underneath incoming */
.hero-slider__slide.is-active {
  clip-path: inset(0 0 0% 0);
  z-index: 2;
  pointer-events: auto;
}

/* Incoming slide sits on top during transition */
.hero-slider__slide.is-entering {
  z-index: 3;
  pointer-events: none;
}

/* ── Background Image + Ken Burns ── */
.hero-slider__bg-wrap {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.hero-slider__bg-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transform-origin: center;
  /* Ken Burns scale will be driven by GSAP */
}

.hero-slider__bg-img--placeholder {
  width: 100%;
  height: 100%;
}

.hero-slider__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    160deg,
    rgba(0, 0, 0, 0.38) 0%,
    rgba(0, 0, 0, 0.18) 50%,
    rgba(0, 0, 0, 0.42) 100%
  );
  z-index: 1;
}

/* ── Text Content ── */
.hero-slider__content {
    position: absolute;
    left: 135px;
    z-index: 5;
    max-width: min(756px, 80vw);
    display: flex;
    flex-direction: column;
    gap: 24px;
    top: 50%;
    transform: translateY(-50%);
}

p.hero-slider__eyebrow {
    font-weight: 400;
    font-size: 16px;
    line-height: 150%;
    letter-spacing: 0px;
    text-transform: capitalize;
    color: #EEF4F9;
    will-change: transform, opacity;
}

.hero-slider__heading>* {
    font-weight: 400;
    font-size: 64px;
    line-height: 100%;
    letter-spacing: 0px;
    text-transform: capitalize;
     margin: 0;
    will-change: transform, opacity;
    color: #EEF4F9;
}

.hero-slider__subheading {
 
  font-weight: 400;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.72);
  margin: 0;
  max-width: 480px;
  will-change: transform, opacity;
}

.hero-slider__cta {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  margin-top: 0.8rem;
  padding: 0.75rem 1.75rem;

  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.55);
  text-decoration: none;
  transition: background 0.28s ease, border-color 0.28s ease;
  will-change: transform, opacity;
}

.hero-slider__cta:hover {
  background: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.9);
}

.hero-slider__cta-arrow {
  display: inline-block;
  transition: transform 0.22s ease;
}

.hero-slider__cta:hover .hero-slider__cta-arrow {
  transform: translateX(4px);
}

/* ─────────────────────────────────────────────
   CONTROLS BAR — bottom left
───────────────────────────────────────────── */
.hero-slider__controls {
    position: absolute;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 33px;
    left: 135px;
    bottom: 67px;
    width: 345px;
    justify-content: space-between;
}
/* 


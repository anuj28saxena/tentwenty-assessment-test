    content: "";
    position: absolute;
    top: 0;
    left: 0;
    transform: translate(-50%, -50%);
    rotate: 45deg;
    height: 100%;
    width: 100%;
    background: #fff;
    animation: move 10s ease infinite;
} */
/* 
@keyframes move {
  0% {
    transform: translate(-50%, -50%) rotate(45deg);
  }
  100% {
    transform: translate(-50%, -50%) rotate(330deg);
  }
} */

/* ── Next thumbnail button ── */
.hero-slider__next-btn {
    display: flex;
    align-items: center;
    gap: 0;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: #fff;
    position: relative;
    border: 1px solid #eef4f94f;
    padding: 22px;
}

.hero-slider__next-thumb-wrap {
    position: relative;
    width: 93px;
    height: 93px;
    /* border: 1.5px solid rgba(255, 255, 255, 0.55); */
    overflow: hidden;
    flex-shrink: 0;
    transition: border-color 0.25s ease;
}

.hero-slider__next-btn:hover .hero-slider__next-thumb-wrap {
  border-color: rgba(255, 255, 255, 0.9);
}

.hero-slider__next-thumb {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.45s ease;
}

.hero-slider__next-btn:hover .hero-slider__next-thumb {
  transform: scale(1.06);
}

.hero-slider__next-thumb-overlay {
    position: absolute;
    inset: 0;
    background: #221F2033;
    pointer-events: none;
    display: block !important;
}


/* ── SVG progress ring ──
   Positioned absolutely outside the thumb box,
   centred over the 80px box + 8px margin on each side = 96×96 total */
.hero-slider__ring-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
    z-index: 5;
}

.hero-slider__ring-track {
  fill: none;
  stroke: unset;
  stroke-width: 3;
}

.hero-slider__ring-fill {
    fill: none;
    stroke: #EEF4F9;
    stroke-width: 8;
    stroke-linecap: square;
  /* dasharray/dashoffset set by JS to PERIMETER (372) */
  stroke-dasharray: 372;
  stroke-dashoffset: 372;
}



.hero-slider__next-label {
    text-transform: capitalize;
    color: rgba(255, 255, 255, 0.75);
    display: block;
    /* display: none; */
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-weight: 400;
    font-size: 16px;
    line-height: 110%;
    letter-spacing: 0px;
}

/* ── Counter + progress ── */
.hero-slider__counter-wrap {
    display: flex;
    align-items: center;
    gap: 17px;
}

span.hero-slider__counter-current {
    font-weight: 400;
    font-size: 16px;
    line-height: 110%;
    letter-spacing: 0px;
}

.hero-slider__counter-current,
.hero-slider__counter-total {
  
  font-weight: 400;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 0.06em;
  min-width: 1.6rem;
  display: block;
  overflow: hidden;
  height: 1.2em;
  line-height: 1.2em;
}

.hero-slider__counter-current {
  text-align: right;
}

/* Digit flip container (GSAP will animate children here) */
.hero-slider__digit-wrap {
  display: inline-block;
  overflow: hidden;
  height: 1.2em;
  vertical-align: bottom;
}

/* ── Progress track ── */
.hero-slider__progress-track {
  width: 103px;
  height: 1px;
  background: rgba(255, 255, 255, 0.28);
  position: relative;
  overflow: hidden;
}

.hero-slider__progress-fill {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  width: 0%;
  background: rgba(255, 255, 255, 0.88);
  /* width driven by GSAP */
}

/* ── Prev arrow ── */
.hero-slider__prev-btn {
  position: absolute;
  bottom: calc(5% + 0.85rem);
  left: calc(5% + 20px);
  transform: translateY(50%);
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
  color: rgba(255,255,255,0);  /* hidden — only Next is in the UI; leave for keyboard users */
  z-index: 10;
  pointer-events: none;
  opacity: 0;
}

/* ─────────────────────────────────────────────
   RESPONSIVE
───────────────────────────────────────────── */
@media screen and (max-width: 749px) {
  .hero-slider__content {
    bottom: 18%;
    left: 6%;
    max-width: 88vw;
  }

  .hero-slider__controls {
    bottom: 4%;
    left: 5%;
    gap: 0.85rem;
  }

  .hero-slider__next-thumb-wrap {
    width: 56px;
    height: 56px;
  }

  .hero-slider__next-label {
    display: none;
  }

  .hero-slider__progress-track {
    width: 70px;
  }

  .hero-slider__heading {
   
  }
}

.hero-slider__progress-fill {
    display: block !important;
}

/* ─────────────────────────────────────────────
   REDUCED MOTION — disable all GSAP animations
   (GSAP respects this via its own check)
───────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  .hero-slider__slide {
    clip-path: none !important;
    transition: opacity 0.4s ease;
  }
  .hero-slider__slide:not(.is-active) {
    opacity: 0;
  }
  .hero-slider__slide.is-active {
    opacity: 1;
  }
  .hero-slider__bg-img {
    transform: none !important;
  }
}
</style>

{%- comment -%} ── JavaScript ── {%- endcomment -%}


{%- comment -%} ── JavaScript ── {%- endcomment -%}
<script>
(function () {
  /* ── Wait for GSAP to be available (loaded in theme.liquid or below) ── */
  function initHeroSlider(sectionEl) {
    if (!sectionEl) return;
    if (typeof gsap === 'undefined') {
      console.warn('[HeroSlider] GSAP not found. Load it before this section.');
      return;
    }

    /* ── DOM refs ── */
    const slides       = Array.from(sectionEl.querySelectorAll('.hero-slider__slide'));
    const thumbImg     = sectionEl.querySelector('.hero-slider__next-thumb');
    const thumbWrapper = sectionEl.querySelector(".hero-slider__next-btn");
    const nextBtn      = sectionEl.querySelector('.hero-slider__next-btn');
    const progressFill = sectionEl.querySelector('.hero-slider__progress-fill');
    const counterCur   = sectionEl.querySelector('.hero-slider__counter-current');
    const ringFill     = sectionEl.querySelector('.hero-slider__ring-fill');
    const ringTrack    = sectionEl.querySelector('.hero-slider__ring-track');
    const SPEED        = parseInt(sectionEl.dataset.autoplaySpeed, 10) || 5000;
    const TRANSITION   = 1.1; // seconds for clip-path wipe

    /* SVG ring perimeter: rect is 93×93, perimeter = 2*(93+93) = 372 */
    const PERIMETER = 372;

    let current     = 0;
    let isAnimating = false;
    let progressTw  = null;
    let ringTw      = null;

    const total = slides.length;
    const pad   = n => String(n + 1).padStart(2, '0');

    /* ─── Ken Burns tween storage (per slide) ─── */
    const kbTweens = [];

    /* ─────────────────────────────────────────────
       INIT: hide all slides, show first
    ───────────────────────────────────────────── */
    function init() {
      /* Set SVG ring dasharray to perimeter */
      if (ringFill)  { ringFill.style.strokeDasharray = PERIMETER; ringFill.style.strokeDashoffset = PERIMETER; }
      if (ringTrack) { ringTrack.style.strokeDasharray = PERIMETER; ringTrack.style.strokeDashoffset = 0; }

      slides.forEach((slide, i) => {
        const img = slide.querySelector('.hero-slider__bg-img');
        if (i === 0) {
          gsap.set(slide, { 'clip-path': 'inset(0 0 0% 0)', zIndex: 2 });
          animateTextIn(slide, 0.2);
          startKenBurns(slide, img);
        } else {
          gsap.set(slide, { 'clip-path': 'inset(0 0 100% 0)', zIndex: 1 });
          gsap.set(img, { scale: 1 });
        }
      });

      updateCounter(0);
      updateThumb(nextSlideIndex(0));
      startProgress();
    }

    /* ─────────────────────────────────────────────
       GOTO — main transition
    ───────────────────────────────────────────── */
    function goTo(targetIdx) {
      if (isAnimating || targetIdx === current) return;
      isAnimating = true;

      stopProgress();

      const prevIdx   = current;
      const prevSlide = slides[prevIdx];
      const nextSlide = slides[targetIdx];
      const nextImg   = nextSlide.querySelector('.hero-slider__bg-img');

      /* ── 1. Kill previous Ken Burns & start fresh on next slide ── */
      if (kbTweens[prevIdx]) kbTweens[prevIdx].kill();

      /* ── 2. Position incoming slide: clip-path hides it (top edge) ── */
      gsap.set(nextSlide, { 'clip-path': 'inset(0 0 100% 0)', zIndex: 3 });
      gsap.set(nextImg, { scale: 1.0, transformOrigin: 'center center' });

      /* ── 3. Animate text OUT on current slide ── */

      // animateTextOut(prevSlide);

      gsap.to(
        prevSlide.querySelectorAll(
          '.hero-slider__eyebrow, .hero-slider__heading, .hero-slider__subheading, .hero-slider__cta'
        ),
        {
          y:-80,
          opacity:0,
          stagger:0.05,
          duration:0.6,
          ease:"power4.in"
        }
      );

      /* ── 4. WIPE: clip-path inset bottom shrinks 100%→0% (curtain drops) ── */

     const thumbWrap =
      sectionEl.querySelector(".hero-slider__next-thumb-wrap");

      const thumbRect =
      thumbWrap.getBoundingClientRect();

      const clone = document.createElement("div");

      clone.classList.add("thumb-transition-clone");

      clone.innerHTML = `
      <img src="${thumbImg.src}">
      `;

      document.body.appendChild(clone);

      gsap.set(clone,{
        left:thumbRect.left,
        top:thumbRect.top,
        width:thumbRect.width,
        height:thumbRect.height
      });
  
      gsap.set(nextSlide,{
        opacity:0,
        scale:1.15,
        zIndex:4
      });

      const tl = gsap.timeline({

        onComplete() {

          clone.remove();

          gsap.set(prevSlide,{
            opacity:0,
            zIndex:1
          });

          gsap.set(nextSlide,{
            clearProps:"all",
            zIndex:2
          });

          current = targetIdx;

          updateCounter(current);
          updateThumb(nextSlideIndex(current));

          startProgress();

          isAnimating = false;
        }
      });

      tl.to(clone,{
        left:0,
        top:0,
        width:"100vw",
        height:"100vh",
        duration:1.25,
        ease:"power4.inOut"
      },0);

      tl.to(prevSlide,{
        scale:0.92,
        opacity:0,
        duration:1.1,
        ease:"power4.inOut"
      },0);

      tl.to(nextSlide,{
        opacity:1,
        scale:1,
        duration:1.2,
        ease:"power4.out"
      },0.2);
     

      nextSlide.classList.add('is-entering');
      prevSlide.classList.remove('is-active');
    }

    /* ─────────────────────────────────────────────
       TEXT IN — eyebrow, heading, subheading, cta
    ───────────────────────────────────────────── */
    function animateTextIn(slide, delay) {
      const eyebrow    = slide.querySelector('.hero-slider__eyebrow');
      const heading    = slide.querySelector('.hero-slider__heading');
      const subheading = slide.querySelector('.hero-slider__subheading');
      const cta        = slide.querySelector('.hero-slider__cta');

      const els = [eyebrow, heading, subheading, cta].filter(Boolean);

      /* Reset first */
      gsap.set(els, { opacity: 0, y: 32, skewY: 1.5 });

      gsap.to(els, {
        opacity: 1,
        y: 0,
        skewY: 0,
        duration: 0.82,
        ease: 'power3.out',
        stagger: 0.1,
        delay: delay + 0.15
      });
    }

    /* ─────────────────────────────────────────────
       TEXT OUT
    ───────────────────────────────────────────── */
    function animateTextOut(slide) {
      const els = slide.querySelectorAll(
        '.hero-slider__eyebrow, .hero-slider__heading, .hero-slider__subheading, .hero-slider__cta'
      );
      gsap.to(els, {
        opacity: 0,
        y: -18,
        duration: 0.38,
        ease: 'power2.in',
        stagger: 0.05
      });
    }

    /* ─────────────────────────────────────────────
       KEN BURNS — slow ambient scale on active bg
    ───────────────────────────────────────────── */
    function startKenBurns(slide, img) {
      if (!img) return;
      gsap.set(img, { scale: 1, transformOrigin: 'center center' });
      kbTweens[slides.indexOf(slide)] = gsap.to(img, {
        scale: 1.0,
        duration: SPEED / 1000 + TRANSITION,
        ease: 'none'
      });
    }

    /* ─────────────────────────────────────────────
       PROGRESS LINE
    ───────────────────────────────────────────── */
    function startProgress() {
      if (progressTw) progressTw.kill();
      if (ringTw) ringTw.kill();

      const dur = SPEED / 1000;

      gsap.set(progressFill, { width: '0%' });
      gsap.set(ringFill, { strokeDashoffset: PERIMETER });

      progressTw = gsap.to(progressFill, {
        width: '100%',
        duration: dur,
        ease: 'none',
        onComplete: () => goTo(nextSlideIndex(current))
      });

      /* Ring draws clockwise from top-right corner (rotate(-90) on rect) */
      ringTw = gsap.to(ringFill, {
        strokeDashoffset: 0,
        duration: dur,
        ease: 'none'
      });
    }

    function stopProgress() {
      if (progressTw) progressTw.kill();
      if (ringTw) ringTw.kill();
      gsap.set(progressFill, { width: '0%' });
      gsap.set(ringFill, { strokeDashoffset: PERIMETER });
    }

    /* ─────────────────────────────────────────────
       COUNTER — digit roll animation
    ───────────────────────────────────────────── */
    function updateCounter(idx) {
      const newLabel = pad(idx);
      /* Simple fade-roll: fade out up, swap, fade in from below */
      gsap.to(counterCur, {
        opacity: 0,
        y: -10,
        duration: 0.2,
        ease: 'power2.in',
        onComplete: () => {
          counterCur.textContent = newLabel;
          gsap.fromTo(counterCur,
            { opacity: 0, y: 10 },
            { opacity: 1, y: 0, duration: 0.28, ease: 'power2.out' }
          );
        }
      });
    }

    /* ─────────────────────────────────────────────
       THUMBNAIL — crossfade next slide preview
    ───────────────────────────────────────────── */
    function updateThumb(nextIdx) {
      const nextSlide = slides[nextIdx];
      if (!nextSlide || !thumbImg) return;
      const src = nextSlide.dataset.thumb;
      if (!src || src === 'undefined') return;

      gsap.to(thumbImg, {
        opacity: 0,
        duration: 0.2,
        onComplete: () => {
          thumbImg.src = src;
          gsap.to(thumbImg, { opacity: 1, duration: 0.35 });
        }
      });
    }

    /* ─────────────────────────────────────────────
       HELPERS
    ───────────────────────────────────────────── */
    function nextSlideIndex(idx) {
      return (idx + 1) % total;
    }

    /* ─────────────────────────────────────────────
       EVENT LISTENERS
    ───────────────────────────────────────────── */
    if (nextBtn) {

      // nextBtn.addEventListener("mouseenter",()=>{

      //     gsap.to(".hero-slider__next-thumb",{
      //       scale:1.12,
      //       duration:.5,
      //       ease:"power3.out"
      //     });

      //     gsap.to(".hero-slider__next-label",{
      //       y:-5,
      //       duration:.4
      //     });

      //   });

      //  nextBtn.addEventListener("mouseleave",()=>{

      //   gsap.to(".hero-slider__next-thumb",{
      //     scale:1
      //   });

      //   gsap.to(".hero-slider__next-label",{
      //     y:0
      //   });

      // });



      nextBtn.addEventListener('click', () => {
        if (!isAnimating) goTo(nextSlideIndex(current));
      });
    }

    /* Touch swipe support */
    let touchStartX = 0;
    let touchStartY = 0;
    sectionEl.addEventListener('touchstart', e => {
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
    }, { passive: true });

    sectionEl.addEventListener('touchend', e => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      const dy = e.changedTouches[0].clientY - touchStartY;
      if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 40) {
        goTo(dx < 0 ? nextSlideIndex(current) : (current - 1 + total) % total);
      }
    }, { passive: true });

    /* Pause on hover */
    sectionEl.addEventListener('mouseenter', () => { if (progressTw) progressTw.pause(); if (ringTw) ringTw.pause(); });
    sectionEl.addEventListener('mouseleave', () => { if (progressTw) progressTw.resume(); if (ringTw) ringTw.resume(); });

    /* Keyboard navigation */
    sectionEl.addEventListener('keydown', e => {
      if (e.key === 'ArrowRight') goTo(nextSlideIndex(current));
      if (e.key === 'ArrowLeft')  goTo((current - 1 + total) % total);
    });

    /* Respect reduced motion */
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) {
      gsap.globalTimeline.timeScale(10);
    }

    /* ── Start ── */
    init();
  }

  /* ── Boot: wait for GSAP CDN to load ── */
  function boot() {
    const id = 'hero-slider-{{ section.id }}';
    const el = document.getElementById(id);
    if (!el) return;

    if (typeof gsap !== 'undefined') {
      initHeroSlider(el);
    } else {
      /* Retry up to 20 times at 100ms intervals */
      let attempts = 0;
      const poll = setInterval(() => {
        attempts++;
        if (typeof gsap !== 'undefined') {
          clearInterval(poll);
          initHeroSlider(el);
        } else if (attempts > 20) {
          clearInterval(poll);
          console.warn('[HeroSlider] GSAP never loaded.');
        }
      }, 100);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }

  /* ── Shopify theme editor live reload ── */
  if (window.Shopify && Shopify.designMode) {
    document.addEventListener('shopify:section:load', e => {
      if (e.target.querySelector('#hero-slider-{{ section.id }}')) boot();
    });
  }
})();
</script>


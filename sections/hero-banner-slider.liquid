

{%- if section.blocks.size > 0 -%}

<section
  class="hero-slider"
  id="hero-slider-{{ section.id }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | default: 5000 }}"
  aria-label="Hero slideshow"
>
  {%- comment -%} ── Slides ── {%- endcomment -%}


  <div class="hero-slider__track swiper mySwiper" aria-live="polite">

   <div class="swiper-wrapper">
    {%- for block in section.blocks -%}

      {% comment %} {%- assign is_first = forloop.first -%} {% endcomment %}
      {%- assign next_index = forloop.index -%}
      {%- if next_index >= section.blocks.size -%}
        {%- assign next_index = 0 -%}
      {%- endif -%}

      <div
        class="hero-slider__slide swiper-slide"
        data-slide-index="{{ forloop.index0 }}"
        data-thumb="{{ block.settings.image | image_url: width: 200 }}"
        {{ block.shopify_attributes }}
        role="group"
        aria-label="Slide {{ forloop.index }} of {{ section.blocks.size }}"
      >


              {%- comment -%} Background image with Ken Burns layer {%- endcomment -%}

              
              <div class="hero-slider__bg-wrap">

              


              <div class="hero-slider__clip">

                <div class="hero-slider__bg-scale">

                    {%- if block.settings.image != blank -%}

                        {%- liquid
                              assign image_loading = 'lazy'
                              assign image_priority = 'auto'

                              if forloop.first
                              assign image_loading = 'eager'
                              assign image_priority = 'high'
                              endif
                        -%}

                        {{
                              block.settings.image
                              | image_url: width: 1920
                              | image_tag:
                              class: 'hero-slider__bg-img',
                              loading: image_loading,
                              fetchpriority: image_priority,
                              widths: '750, 1100, 1500, 1780, 1920',
                              sizes: '100vw',
                              alt: block.settings.image.alt
                        }}
                      
                        
                    {%- else -%}
                      {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-slider__bg-img hero-slider__bg-img--placeholder' }}
                    {%- endif -%}
                </div>

              </div>

                  <div class="hero-slider__overlay"></div>
              </div>

       
        {%- comment -%} Slide text content {%- endcomment -%}
        <div class="hero-slider__content">
          <div class="overflow-hidden">
            {%- if block.settings.eyebrow != blank -%}
              <p class="hero-slider__eyebrow reveal-text">{{ block.settings.eyebrow | escape }}</p>
            {%- endif -%}
          </div>
            <div class="overflow-hidden">

              {%- if block.settings.heading != blank -%}
                <div class="hero-slider__heading reveal-text">
                  {{ block.settings.heading }}
                  </div>
                {%- endif -%}
                </div>
                <div class="overflow-hidden">
                  {%- if block.settings.subheading != blank -%}
                    <p class="hero-slider__subheading reveal-text">{{ block.settings.subheading | escape }}</p>
                  {%- endif -%}
                  </div>
          {%- if block.settings.button_label != blank and block.settings.button_url != blank -%}
            <a
              href="{{ block.settings.button_url }}"
              class="hero-slider__cta"
              {% if block.settings.button_new_tab %}target="_blank" rel="noopener"{% endif %}
            >
              {{- block.settings.button_label | escape -}}
              <span class="hero-slider__cta-arrow" aria-hidden="true">→</span>
            </a>
          {%- endif -%}
        </div>
      </div>
      {%- endfor -%}

    </div>
{% comment %} 

    <div class="swiper-button-next"></div>
    <div class="swiper-button-prev"></div>
    <div class="swiper-pagination"></div> {% endcomment %}

  </div>

  {%- comment -%} ── Controls Bar (bottom-left) ── {%- endcomment -%}
  <div class="hero-slider__controls" aria-label="Slider controls">

    {%- comment -%} Next-slide thumbnail button {%- endcomment -%}
    <button
      class="hero-slider__next-btn"
      aria-label="Next slide"
      type="button"
    >
      <div class="hero-slider__next-thumb-wrap">
        <img
          class="hero-slider__next-thumb"
          src="{{ section.blocks[1].settings.image | image_url: width: 200 }}"
          alt="Next slide preview"
          width="80"
          height="80"
          loading="lazy"
        />
        <div class="hero-slider__next-thumb-overlay"></div>
      </div>

    
      <svg class="hero-slider__ring-svg" viewBox="0 0 96 96" aria-hidden="true" focusable="false">
        <rect class="hero-slider__ring-track"
          x="1.5" y="1.5" width="93" height="93"
        />
        <rect class="hero-slider__ring-fill"
          x="1.5" y="1.5" width="93" height="93"
          transform="rotate(-90 48 48)"
        />
      </svg>

      <span class="hero-slider__next-label">Next</span>
    </button>

    {%- comment -%} Counter + progress line {%- endcomment -%}
    <div class="hero-slider__counter-wrap" aria-hidden="true">
      <span class="hero-slider__counter-current">
         01
      </span>
      <div class="hero-slider__progress-track">
        <div class="hero-slider__progress-fill"></div>
      </div>
      <span class="hero-slider__counter-total">
        {{- section.blocks.size | prepend: '0' | slice: -2, 2 -}}
      </span>
    </div>

  </div>

  {%- comment -%} Prev button (optional, accessible) {%- endcomment -%}
  <button
    class="hero-slider__prev-btn"
    aria-label="Previous slide"
    type="button"
  >
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="M12.5 5L7.5 10L12.5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

</section>

{%- endif -%}



{% schema %}
{
  "name": "Hero Slider",
  "tag": "section",
  "class": "section-hero-slider",
  "limit": 1,
  "settings": [
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed (ms)",
      "min": 3000,
      "max": 9000,
      "step": 500,
      "default": 5000
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow text",
          "default": "Welcome To"
        },
        {
          "type": "richtext",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "info": "Optional supporting text beneath the heading"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        },
        {
          "type": "checkbox",
          "id": "button_new_tab",
          "label": "Open button link in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slider",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "eyebrow": "Welcome To",
            "heading": "<h2>Slide One</h2>"
          }
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "Discover",
            "heading": "<h2>Slide Two</h2>"
          }
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "Explore",
            "heading": "<h2>Slide Three</h2>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
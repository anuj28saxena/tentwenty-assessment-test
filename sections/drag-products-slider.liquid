{% comment %}
  Quality Products Section — Dawn Theme
  Header (title + description) + horizontal drag-to-scroll product blocks
{% endcomment %}

<style>
  .quality-products {
    background-color: {{ section.settings.background_color }};
    padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px;
  }

  .quality-products__header {
    text-align: {{ section.settings.header_alignment }};
    max-width: {{ section.settings.header_max_width }}px;
    /* margin: 0 auto {{ section.settings.header_bottom_gap }}px; */
    margin: 0 auto 100px;
    padding: 0 ;
  }
  
  .quality-products__title {
      font-weight: 400;
      font-size: 56px;
      line-height: 72px;
      letter-spacing: -1px;
      text-align: center;
     height: 92px;
  }

  .quality-products__slider-wrapper {
    position: relative;
    padding: 0 {{ section.settings.slider_side_padding }}px;
  }

  .quality-products__slider {
    display: flex;
    gap: {{ section.settings.card_gap }}px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
    padding-bottom: 16px;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .quality-products__slider::-webkit-scrollbar {
    display: none;
  }

  .quality-products__slider.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }

  .quality-products__card {
    flex: 0 0 {{ section.settings.card_width }}px;
    scroll-snap-align: start;
    background: {{ section.settings.card_background }};
    border-radius: {{ section.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .quality-products__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.08);
  }

  .quality-products__card-image-wrap {
    width: 100%;
    overflow: hidden;
  }

  .quality-products__card-image-wrap--square   { aspect-ratio: 1 / 1; }
  .quality-products__card-image-wrap--portrait  { aspect-ratio: 3 / 4; }
  .quality-products__card-image-wrap--landscape { aspect-ratio: 4 / 3; }
  .quality-products__card-image-wrap--tall      { aspect-ratio: 2 / 3; }

  .quality-products__card-image-wrap img,
  .quality-products__card-image-wrap .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .quality-products__card:hover .quality-products__card-image-wrap img {
    transform: scale(1.04);
  }

  .quality-products__card-body {
    padding: {{ section.settings.card_inner_padding }}px;
  }

  .quality-products__card-type {
    font-family: var(--font-body-family);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: {{ section.settings.card_type_color }};
    margin: 0 0 8px;
  }

  .quality-products__card-heading {
    font-family: var(--font-heading-family);
    font-size: {{ section.settings.card_heading_size }}px;
    font-weight: var(--font-heading-weight);
    color: {{ section.settings.card_heading_color }};
    margin: 0 0 10px;
    line-height: 1.3;
  }

  .quality-products__card-desc {
    font-family: var(--font-body-family);
    font-size: {{ section.settings.card_desc_size }}px;
    color: {{ section.settings.card_desc_color }};
    line-height: 1.6;
    margin: 0;
  }

  /* ── Mobile ── */
  @media screen and (max-width: 768px) {
    .quality-products__card {
      flex: 0 0 {{ section.settings.card_width_mobile }}px;
    }
    .quality-products__slider-wrapper {
      padding: 0 16px;
    }
  }
</style>

<section
  class="quality-products"
  id="quality-products-{{ section.id }}"
>
  {%- comment %} ── Section Header ── {% endcomment -%}
  <div class="quality-products__header">
    {%- if section.settings.title != blank -%}
      <h2 class="quality-products__title heading-h2-56 ">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <div class="quality-products__description heading-24 text-[#7A7777]">
          {{ section.settings.description }}
      </div>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
  <div class="quality-products__slider-wrapper">
    <div
      class="quality-products__slider"
      id="qp-slider-{{ section.id }}"
      role="list"
      aria-label="{{ section.settings.title | escape }}"
    >
      {%- for block in section.blocks -%}
        {%- if block.type == 'product_card' -%}
        <div
          class="quality-products__card"
          role="listitem"
          {{ block.shopify_attributes }}
        >
          <div class="quality-products__card-image-wrap quality-products__card-image-wrap--{{ block.settings.image_ratio }}">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                loading="lazy"
                width="800"
                height="800"
              >
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>

          <div class="quality-products__card-body">
            {%- if block.settings.product_type != blank -%}
              <p class="quality-products__card-type">{{ block.settings.product_type }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h3 class="quality-products__card-heading">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
               <div class="quality-products__card-desc heading-16 text-[#7A7777]">
                  {{ block.settings.description }}
               </div>
          {%- endif -%}  
          </div>
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}
</section>

<script>
(function () {
  const slider = document.getElementById('qp-slider-{{ section.id }}');
  if (!slider) return;

  let isDragging = false;
  let startX, scrollStart;

  function onPointerDown(e) {
    isDragging = true;
    startX = e.clientX ?? e.touches?.[0]?.clientX;
    scrollStart = slider.scrollLeft;
    slider.classList.add('is-dragging');
  }

  function onPointerMove(e) {
    if (!isDragging) return;
    const x = e.clientX ?? e.touches?.[0]?.clientX;
    const dx = x - startX;
    slider.scrollLeft = scrollStart - dx;
  }

  function onPointerUp() {
    isDragging = false;
    slider.classList.remove('is-dragging');
  }

  // Mouse
  slider.addEventListener('mousedown', onPointerDown);
  window.addEventListener('mousemove', onPointerMove);
  window.addEventListener('mouseup', onPointerUp);

  // Touch
  slider.addEventListener('touchstart', onPointerDown, { passive: true });
  slider.addEventListener('touchmove', onPointerMove, { passive: true });
  slider.addEventListener('touchend', onPointerUp);

  // Prevent click-through after drag
  slider.addEventListener('click', function (e) {
    if (Math.abs(slider.scrollLeft - scrollStart) > 5) {
      e.preventDefault();
      e.stopPropagation();
    }
  }, true);
})();
</script>


{% comment %}
  Quality Products Section — Dawn Theme
  Header (title + description) + horizontal drag-to-scroll product blocks
{% endcomment %}

<style>
  .quality-products {
    background-color: {{ section.settings.background_color }};
    padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px;
    overflow: hidden;
    position: relative;
  }

  /* ---------------- HEADER ---------------- */

  .quality-products__header {
    text-align: {{ section.settings.header_alignment }};
    max-width: {{ section.settings.header_max_width }}px;
    margin: 0 auto 100px;
  }

  .quality-products__title {
    font-weight: 400;
    font-size: 56px;
    line-height: 72px;
    letter-spacing: -1px;
    text-align: center;
  }

  .quality-products__description {
    text-align: center;
  }

  /* ---------------- SLIDER ---------------- */

  .quality-products__slider-wrapper {
    width: 100%;
    position: relative;
  }

  .quality-products__viewport {
    width: 100%;
    overflow: hidden;
    cursor: grab;
    padding: 80px 0;
  }

  .quality-products__viewport:active {
    cursor: grabbing;
  }

  .quality-products__track {
    display: flex;
    align-items: center;
    gap: 0;
    width: max-content;
    will-change: transform;
  }

  /* ---------------- CARD ---------------- */

  .quality-products__card {
    width: 340px;
    flex-shrink: 0;
    margin: 0 -70px;
    position: relative;
  }

  .quality-products__viewport {
     perspective: 1500px;
     }

     .quality-products__card.prev .quality-products__card-inner {
          transform:
          rotate(-10deg)
          scale(.88)
          translateZ(-100px);
          }

          .quality-products__card.next .quality-products__card-inner {
          transform:
          rotate(10deg)
          scale(.88)
          translateZ(-100px);
          }

  .quality-products__card-inner {
    background: #fff;
    padding: 24px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);

   transition:
     transform .45s cubic-bezier(.22,.61,.36,1),
     opacity .45s cubic-bezier(.22,.61,.36,1);
  }

  .quality-products__card-image-wrap {
    width: 100%;
    overflow: hidden;
  }

  .quality-products__card-image-wrap--square {
    aspect-ratio: 1 / 1;
  }

  .quality-products__card-image-wrap--portrait {
    aspect-ratio: 3 / 4;
  }

  .quality-products__card-image-wrap--landscape {
    aspect-ratio: 4 / 3;
  }

  .quality-products__card-image-wrap--tall {
    aspect-ratio: 2 / 3;
  }

  .quality-products__card-image-wrap img,
  .quality-products__card-image-wrap .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .quality-products__card-body {
    padding-top: 20px;
  }

  .quality-products__card-type {
    font-family: var(--font-body-family);
    font-size: 11px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: {{ section.settings.card_type_color }};
    margin-bottom: 8px;
  }

  .quality-products__card-heading {
    font-family: var(--font-heading-family);
    font-size: {{ section.settings.card_heading_size }}px;
    font-weight: var(--font-heading-weight);
    color: {{ section.settings.card_heading_color }};
    margin-bottom: 10px;
    line-height: 1.3;
  }

  .quality-products__card-desc {
    font-family: var(--font-body-family);
    font-size: {{ section.settings.card_desc_size }}px;
    color: {{ section.settings.card_desc_color }};
    line-height: 1.6;
  }

  /* ---------------- STATES ---------------- */

  .quality-products__card.prev .quality-products__card-inner {
    transform: rotate(-10deg) scale(.9);
    /* opacity: .8; */
  }

  .quality-products__card.active .quality-products__card-inner {
    transform: rotate(0deg) scale(1);
    opacity: 1;
    z-index: 2;
  }

  .quality-products__card.next .quality-products__card-inner {
    transform: rotate(10deg) scale(.9);
    /* opacity: .8; */
  }

  .quality-products__card:not(.active):not(.prev):not(.next) {
    opacity: .4;
  }

  /* ---------------- MOBILE ---------------- */

  @media screen and (max-width: 768px) {

    .quality-products__viewport {
      padding: 40px 0;
    }

    .quality-products__card {
      width: 280px;
      margin: 0 -10px;
    }

    .quality-products__card-inner {
      padding: 16px;
    }

    .quality-products__title {
      font-size: 36px;
      line-height: 44px;
    }
  }
</style>

<section
  class="quality-products"
  id="quality-products-{{ section.id }}"
>
  {%- comment %} ── Section Header ── {% endcomment -%}
  <div class="quality-products__header">
    {%- if section.settings.title != blank -%}
      <h2 class="quality-products__title heading-h2-56 ">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <div class="quality-products__description heading-24 text-[#7A7777]">
          {{ section.settings.description }}
      </div>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}

     <div class="quality-products__slider-wrapper">

          <div class="quality-products__viewport" id="qp-viewport-{{ section.id }}">

          <div
               class="quality-products__track"
               id="qp-slider-{{ section.id }}"
          >

               {%- for block in section.blocks -%}

               <div
                    class="quality-products__card"
                    data-index="{{ forloop.index0 }}"
                    {{ block.shopify_attributes }}
               >

                    <div class="quality-products__card-inner">

                    <div class="quality-products__card-image-wrap quality-products__card-image-wrap--{{ block.settings.image_ratio }}">

                    {%- if block.settings.image != blank -%}
                         <img
                         src="{{ block.settings.image | image_url: width: 800 }}"
                         alt="{{ block.settings.heading | escape }}"
                         loading="lazy"
                         width="800"
                         height="800"
                         >
                    {%- endif -%}

                    </div>

                    <div class="quality-products__card-body">

                    {% if block.settings.product_type != blank %}
                         <p class="quality-products__card-type">
                         {{ block.settings.product_type }}
                         </p>
                    {% endif %}

                    {% if block.settings.heading != blank %}
                         <h3 class="quality-products__card-heading">
                         {{ block.settings.heading }}
                         </h3>
                    {% endif %}

                    {% if block.settings.description != blank %}
                         <div class="quality-products__card-desc">
                         {{ block.settings.description }}
                         </div>
                    {% endif %}

                    </div>

                    </div>

               </div>

               {%- endfor -%}

          </div>

          </div>

     </div>




  {%- endif -%}
  
</section>




<script>
  
  document.addEventListener("DOMContentLoaded", () => {

  gsap.registerPlugin(Draggable);

  const viewport =
    document.getElementById("qp-viewport-{{ section.id }}");

  const track =
    document.getElementById("qp-slider-{{ section.id }}");

  const cards =
    [...track.querySelectorAll(".quality-products__card")];

  let activeIndex = 1;

  function updateCards() {

    cards.forEach(card => {
      card.classList.remove(
        "prev",
        "active",
        "next"
      );
    });

    cards[activeIndex]?.classList.add("active");
    cards[activeIndex - 1]?.classList.add("prev");
    cards[activeIndex + 1]?.classList.add("next");

  }

  function centerCard(index, animate = true) {

    activeIndex = index;

    const card = cards[index];

    const viewportCenter =
      viewport.offsetWidth / 2;

    const cardCenter =
      card.offsetLeft +
      card.offsetWidth / 2;

    const x =
      viewportCenter - cardCenter;

    if (animate) {
      gsap.to(track,{
        x,
        duration:0.8,
        ease:"power3.out"
      });
    } else {
      gsap.set(track,{ x });
    }

    updateCards();
  }

  centerCard(activeIndex,false);

  function getNearestCard() {

  const viewportCenter =
    viewport.getBoundingClientRect().left +
    viewport.offsetWidth / 2;

  let nearest = 0;
  let smallest = Infinity;

  cards.forEach((card, index) => {

    const rect = card.getBoundingClientRect();

    const center =
      rect.left + rect.width / 2;

    const distance =
      Math.abs(center - viewportCenter);

    if (distance < smallest) {
      smallest = distance;
      nearest = index;
    }

  });

  return nearest;
}

  Draggable.create(track, {

     type: "x",

     onDrag() {

     const nearest =
          getNearestCard();

     if (nearest !== activeIndex) {

          activeIndex = nearest;

          updateCards();

     }

     },

     onDragEnd() {

     centerCard(activeIndex);

     }

     });

});

</script>

